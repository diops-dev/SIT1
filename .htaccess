# ==========================================================
#  Solidaire Inca Tour, configuration Apache (Hostinger)
# ==========================================================

# ---- Page d'accueil ----
# Sans cette ligne, Apache sert le premier fichier de sa liste par defaut
# (index.php, index.htm, ...). Si un vieux fichier de ce nom traine dans
# public_html, l'adresse courte du site affiche l'ancienne version pendant
# que /index.html affiche la nouvelle. On impose donc index.html.
DirectoryIndex index.html

# ---- Page d'erreur ----
ErrorDocument 404 /404.html

# ---- HTTPS et www ----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forcer le HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Forcer le www
  RewriteCond %{HTTP_HOST} ^solidaireincatour\.fr$ [NC]
  RewriteRule ^(.*)$ https://www.solidaireincatour.fr/$1 [R=301,L]
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- Cache navigateur ----
# Les images et les polices ne changent jamais de contenu sous un meme nom :
# on les garde un an. Les pages, les styles, les scripts et les donnees, eux,
# changent a chaque mise a jour du site : le navigateur doit revenir demander
# au serveur s'ils ont bouge. Le serveur repond 304 si rien n'a change, donc
# cela ne coute presque rien, et une correction est visible immediatement.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg           "access plus 1 year"
  ExpiresByType image/png            "access plus 1 year"
  ExpiresByType image/webp           "access plus 1 year"
  ExpiresByType image/svg+xml        "access plus 1 year"
  ExpiresByType image/x-icon         "access plus 1 year"
  ExpiresByType font/woff2           "access plus 1 year"
  ExpiresDefault                     "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---- En-tetes de securite ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---- Encodage ----
AddDefaultCharset UTF-8
